## Mock Helpers (`src/lib/mock-utils.ts`)
```typescript
export const delay = (ms: number) => new Promise(res => setTimeout(res, ms));

export function mockResponse<T>(data: T, status = 200): ApiResponse<T> {
  return { status, message: 'success', data };
}
```

